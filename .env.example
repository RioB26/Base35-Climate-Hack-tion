# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
# Load for CLI/pipeline commands with:  set -a; source .env; set +a
# The web app (vite) reads the VITE_ values from this same file.

# --- Web app (public by design: row-level security makes the anon key read-only) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Supabase project ---
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_URL=https://<project-ref>.supabase.co
# SECRET: Project Settings > API > service_role. Used by pipeline/run_site.py and seed_supabase.py.
SUPABASE_SERVICE_KEY=
# SECRET: only needed for `supabase db push` if the CLI asks for it.
SUPABASE_DB_PASSWORD=

# --- add-site Edge Function (set with: supabase secrets set --env-file .env.functions, or one by one) ---
# SECRET: passcode users type into the Add a landfill form.
ADD_SITE_PASSCODE=
# SECRET: fine-grained GitHub token, Actions: write on GH_REPO only.
GH_DISPATCH_TOKEN=
GH_REPO=owner/repo

# --- Earth Engine (satellite pipeline) ---
EE_PROJECT=
# SECRET: service account JSON key on ONE line, e.g. EE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'
# Leave blank locally to use your own `earthengine authenticate` login.
EE_SERVICE_ACCOUNT_KEY=
